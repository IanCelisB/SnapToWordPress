# ------------------------------------------------------------------
# Local environment variables. DO NOT COMMIT real values.
# Copy this file to `.env` and fill in your store credentials.
# `.env` is gitignored.
# ------------------------------------------------------------------

# Base URL of the WooCommerce store (https only in production).
WC_STORE_URL=https://your-store.example.com

# WooCommerce REST API credentials (keys, NOT the admin password).
# Generate at:  wp-admin → WooCommerce → Settings → Advanced → REST API
WC_CONSUMER_KEY=ck_replace_me
WC_CONSUMER_SECRET=cs_replace_me
